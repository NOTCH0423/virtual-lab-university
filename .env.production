# ===============================================
# CONFIGURACIÓN DE BASE DE DATOS - NEON (POSTGRESQL)
# ===============================================
# 
# 1. Ve a https://neon.tech y crea una cuenta gratuita
# 2. Crea un nuevo proyecto
# 3. Copia la connection string de tu proyecto
# 4. Reemplaza la URL abajo con tu connection string
#
# Ejemplo de connection string:
# postgresql://usuario:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL="postgresql://TU_USUARIO:TU_PASSWORD@host/neondb?sslmode=require"

# ===============================================
# NEXTAUTH CONFIGURATION
# ===============================================
NEXTAUTH_URL="https://virtual-lab-university.vercel.app"
NEXTAUTH_SECRET="genera-otra-clave-secreta-con-openssl-rand-base64-32"

# ===============================================
# GITHUB OAUTH
# ===============================================
# Ve a https://github.com/settings/developers
# Crea una nueva OAuth App con:
# - Homepage URL: https://virtual-lab-university.vercel.app
# - Authorization callback URL: https://virtual-lab-university.vercel.app/api/auth/callback/github
GITHUB_ID="tu-github-client-id"
GITHUB_SECRET="tu-github-client-secret"
